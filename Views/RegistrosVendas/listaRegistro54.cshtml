@model IEnumerable<RelatoriosRosset.Models.Registro54Result>
@{
    ViewData["Title"] = "Gera Registros Fiscais";
}

<h2>Gera Registros Fiscais</h2>

<form asp-action="listaRegistro54" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-4">
            <label>Data Início</label>
            <input type="date" name="dataInicio" class="form-control"
                   value="@(ViewBag.DataInicio?.ToString("yyyy-MM-dd"))" />
        </div>

        <div class="col-md-4">
            <label>Data Fim</label>
            <input type="date" name="dataFim" class="form-control"
                   value="@(ViewBag.DataFim?.ToString("yyyy-MM-dd"))" />
        </div>

        <div class="col-md-4 align-self-end">
            <button type="submit" class="btn btn-primary">Pesquisar</button>

            <a asp-action="ExportarExcel"
               asp-route-dataInicio="@ViewBag.DataInicio?.ToString("yyyy-MM-dd")"
               asp-route-dataFim="@ViewBag.DataFim?.ToString("yyyy-MM-dd")"
               class="btn btn-success">Gerar Excel</a>
        </div>
    </div>
</form>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>TIPO_REGISTRO</th>
                <th>CPF_CGC</th>
                <th>MODELO</th>
                <th>SERIE_NF</th>
                <th>NF</th>
                <th>COD_FISCAL_OP</th>
                <th>TRIBUT_ICMS</th>
                <th>ITEM_CFE</th>
                <th>CODIGO_ITEM</th>
                <th>CODIGO_BARRA</th>
                <th>QTDE_ITEM</th>
                <th>VALOR_ITEM</th>
                <th>DESCONTO_ITEM</th>
                <th>BASE_IMPOSTO</th>
                <th>BASE_IMP_SUBST</th>
                <th>VALOR_IPI</th>
                <th>TAXA_IMPOSTO</th>
                <th>VALOR_CONTABIL</th>
                <th>VALOR_ICMS</th>
                <th>FILIAL_CHAVE</th>
                <th>NF_SAIDA_CHAVE</th>
                <th>SERIE_NF_CHAVE</th>
                <th>COD_MATRIZ_FISCAL</th>
                <th>MATRIZ_FISCAL</th>
                <th>EMISSAO</th>
                <th>DESCRICAO_ITEM</th>
                <th>UNIDADE</th>
                <th>RG_IE</th>
                <th>CLASSIF_FISCAL</th>
                <th>UF</th>
                <th>PAIS</th>
                <th>ITEM_IMPRESSAO</th>
                <th>COD_FILIAL</th>
                <th>NOTA_CANCELADA</th>
                <th>SERIE_CFE_SAT</th>
                <th>CHAVE_NFE</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td>@v.TIPO_REGISTRO</td>
                    <td>@v.CPF_CGC</td>
                    <td>@v.MODELO</td>
                    <td>@v.SERIE_NF</td>
                    <td>@v.NF</td>
                    <td>@v.CODIGO_FISCAL_OPERACAO</td>
                    <td>@v.TRIBUT_ICMS</td>
                    <td>@v.ITEM_CFE</td>
                    <td>@v.CODIGO_ITEM</td>
                    <td>@v.CODIGO_BARRA</td>
                    <td>@v.QTDE_ITEM</td>
                    <td>@v.VALOR_ITEM</td>
                    <td>@v.DESCONTO_ITEM</td>
                    <td>@v.BASE_IMPOSTO</td>
                    <td>@v.BASE_IMPOSTO_SUBST</td>
                    <td>@v.VALOR_IPI</td>
                    <td>@v.TAXA_IMPOSTO</td>
                    <td>@v.VALOR_CONTABIL</td>
                    <td>@v.VALOR_ICMS</td>
                    <td>@v.FILIAL_CHAVE</td>
                    <td>@v.NF_SAIDA_CHAVE</td>
                    <td>@v.SERIE_NF_CHAVE</td>
                    <td>@v.COD_MATRIZ_FISCAL</td>
                    <td>@v.MATRIZ_FISCAL</td>
                    <td>@v.EMISSAO</td>
                    <td>@v.DESCRICAO_ITEM</td>
                    <td>@v.UNIDADE</td>
                    <td>@v.RG_IE</td>
                    <td>@v.CLASSIF_FISCAL</td>
                    <td>@v.UF</td>
                    <td>@v.PAIS</td>
                    <td>@v.ITEM_IMPRESSAO</td>
                    <td>@v.COD_FILIAL</td>
                    <td>@v.NOTA_CANCELADA</td>
                    <td>@v.SERIE_CFE_SAT</td>
                    <td>@v.CHAVE_NFE</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Nenhum registro encontrado.</p>
}
